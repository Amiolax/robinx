# tg-sniper — environment template.
# Copy to .env and fill in. PLACEHOLDERS ONLY — never commit a real .env.
#
#   cp .env.example .env
#
# .env is gitignored. Double-check that before you paste anything real, and note
# that $HOME here is itself a git repo — see README "Repo hygiene warning".

# ---------------------------------------------------------------- required ---

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Master key for AES-256-GCM encryption of user private keys.
# 32 bytes as 64 hex chars. Generate with:  npm run genkey
#
# WARNING: if you lose or change this value, EVERY stored user wallet becomes
# permanently undecryptable and any funds in them are unrecoverable. Back it up
# somewhere other than this machine.
WALLET_ENC_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_npm_run_genkey

# ------------------------------------------------- Robinhood Chain (primary) --

# These have NO safe default and are intentionally not guessed in
# config/default.json. Fill either here or there.
# A wrong chain ID means signing transactions for the wrong chain.
SNIPER_RPC_ROBINHOOD=https://REPLACE_WITH_ROBINHOOD_CHAIN_RPC_URL
SNIPER_CHAINID_ROBINHOOD=REPLACE_WITH_ROBINHOOD_CHAIN_ID

# Comma-separate multiple endpoints for failover (recommended — this chain's
# public RPC is new and the executor is built to rotate away from a dead node):
# SNIPER_RPC_ROBINHOOD=https://rpc-a.example,https://rpc-b.example

# ---------------------------------------------------------- marketplace API --

# OpenSea API key. Required for most v2 endpoints.
OPENSEA_API_KEY=REPLACE_WITH_OPENSEA_API_KEY

# Only needed if/when those resolvers get implemented (currently stubs).
MAGICEDEN_API_KEY=
RARIBLE_API_KEY=

# Etherscan-compatible explorer key, for verified-ABI lookup. Optional: without
# it the executor falls back to generic mint()/claim() selectors, which is the
# expected path on Robinhood Chain today.
EXPLORER_API_KEY=

# ------------------------------------------------- optional: other networks --

# SNIPER_RPC_ETHEREUM=https://REPLACE_ME
# SNIPER_RPC_BASE=https://mainnet.base.org
# SNIPER_RPC_POLYGON=https://polygon-rpc.com
# SNIPER_RPC_SOLANA=https://api.mainnet-beta.solana.com
